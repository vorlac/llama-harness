{
  "group": "pathological",
  "description": "The catastrophic-backtracking guard and the throughput floor. Every case here is trivial for an NFA simulation and impossible for a backtracking matcher: the per-case time limit is enforced by the runner and a case that exceeds it FAILS.",
  "default_time_limit_ms": 2500,
  "cases": [
    {"id": "pathological-001", "cmd": "match", "pattern_build": [["(a+)+b", 1]], "subject_build": [["a", 200]], "expect": {"match": null}, "time_limit_ms": 2500, "note": "backtracking cost is exponential in the subject length; an NFA simulation answers in microseconds"},
    {"id": "pathological-002", "cmd": "match", "pattern_build": [["(a+)+b", 1]], "subject_build": [["a", 200], ["b", 1]], "expect": {"match": [[0, 201], [0, 200]]}, "time_limit_ms": 2500, "note": "same pattern, this time it matches"},
    {"id": "pathological-003", "cmd": "match", "pattern_build": [["(a*)*b", 1]], "subject_build": [["a", 200]], "expect": {"match": null}, "time_limit_ms": 2500, "note": "backtracking cost is exponential in the subject length; an NFA simulation answers in microseconds"},
    {"id": "pathological-004", "cmd": "match", "pattern_build": [["(a|a)*b", 1]], "subject_build": [["a", 120]], "expect": {"match": null}, "time_limit_ms": 2500, "note": "backtracking cost is exponential in the subject length; an NFA simulation answers in microseconds"},
    {"id": "pathological-005", "cmd": "match", "pattern_build": [["(x+x+)+y", 1]], "subject_build": [["x", 160]], "expect": {"match": null}, "time_limit_ms": 2500, "note": "backtracking cost is exponential in the subject length; an NFA simulation answers in microseconds"},
    {"id": "pathological-006", "cmd": "match", "pattern_build": [["(a{1,10}){1,10}b", 1]], "subject_build": [["a", 150]], "expect": {"match": null}, "time_limit_ms": 2500, "note": "backtracking cost is exponential in the subject length; an NFA simulation answers in microseconds"},
    {"id": "pathological-007", "cmd": "match", "pattern_build": [["((a*)*)*b", 1]], "subject_build": [["a", 120]], "expect": {"match": null}, "time_limit_ms": 2500, "note": "backtracking cost is exponential in the subject length; an NFA simulation answers in microseconds"},
    {"id": "pathological-008", "cmd": "match", "pattern_build": [["(?:a+)+$", 1]], "subject_build": [["a", 150], ["b", 1]], "expect": {"match": null}, "time_limit_ms": 2500, "note": "backtracking cost is exponential in the subject length; an NFA simulation answers in microseconds"},
    {"id": "pathological-009", "cmd": "match", "pattern_build": [["(.*)*b", 1]], "subject_build": [["a", 120]], "expect": {"match": null}, "time_limit_ms": 2500, "note": "backtracking cost is exponential in the subject length; an NFA simulation answers in microseconds"},
    {"id": "pathological-010", "cmd": "match", "pattern_build": [["(a|aa)+$", 1]], "subject_build": [["a", 120], ["b", 1]], "expect": {"match": null}, "time_limit_ms": 2500, "note": "backtracking cost is exponential in the subject length; an NFA simulation answers in microseconds"},
    {"id": "pathological-011", "cmd": "match", "pattern_build": [["a?", 60], ["a", 60]], "subject_build": [["a", 59]], "expect": {"match": null}, "time_limit_ms": 2500, "note": "the classic (a?){n}a{n} blow-up, one code point short of a match"},
    {"id": "pathological-012", "cmd": "match", "pattern_build": [["a?", 60], ["a", 60]], "subject_build": [["a", 60]], "expect": {"match": [[0, 60]]}, "time_limit_ms": 2500, "note": "the same pattern on a subject that does match"},
    {"id": "pathological-013", "cmd": "find", "pattern_build": [["(a+)+b", 1]], "subject_build": [["a", 120], ["c", 1], ["a", 120]], "expect": {"find": []}, "time_limit_ms": 2500, "note": "no match anywhere, so every start position is explored"},
    {"id": "pathological-014", "cmd": "match", "pattern_build": [["(?:a|b)*abb", 1]], "subject_build": [["ab", 5000]], "expect": {"match": null}, "time_limit_ms": 8000, "note": "throughput floor: a 10000 code point subject with no match; the search must be one pass, not one restart per position"},
    {"id": "pathological-015", "cmd": "match", "pattern_build": [[".*x.*y.*z", 1]], "subject_build": [["a", 5000], ["x", 1], ["a", 5000], ["y", 1], ["z", 1]], "expect": {"match": [[0, 10003]]}, "time_limit_ms": 8000, "note": "throughput floor over a 10003 code point subject"},
    {"id": "pathological-016", "cmd": "match", "pattern_build": [["a$", 1]], "subject_build": [["a", 40000]], "expect": {"match": [[39999, 40000]]}, "time_limit_ms": 8000, "note": "the leftmost match starts at the last code point; a matcher that restarts the simulation at each start position is quadratic and will not finish in time"},
    {"id": "pathological-017", "cmd": "find", "pattern_build": [["\\\\d+", 1]], "subject_build": [["a", 9], ["7", 1]], "expect": {"find": [[9, 10]]}, "time_limit_ms": 8000, "note": "sanity control for the FIND scan used by the next case"},
