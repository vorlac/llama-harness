{
  "group": "alternation",
  "description": "Alternation and its leftmost-first preference order: the first branch that can match at the leftmost position wins, even when a later branch would match more text.",
  "default_time_limit_ms": 2000,
  "cases": [
    {"id": "alternation-001", "cmd": "match", "pattern": "a|b", "subject": "b", "expect": {"match": [[0, 1]]}},
    {"id": "alternation-002", "cmd": "match", "pattern": "a|b", "subject": "a", "expect": {"match": [[0, 1]]}},
    {"id": "alternation-003", "cmd": "match", "pattern": "a|b", "subject": "c", "expect": {"match": null}},
    {"id": "alternation-004", "cmd": "match", "pattern": "a|b", "subject": "ba", "expect": {"match": [[0, 1]]}},
    {"id": "alternation-005", "cmd": "match", "pattern": "ab|a", "subject": "ab", "expect": {"match": [[0, 2]]}},
    {"id": "alternation-006", "cmd": "match", "pattern": "a|ab", "subject": "ab", "expect": {"match": [[0, 1]]}},
    {"id": "alternation-007", "cmd": "match", "pattern": "abc|abd", "subject": "abd", "expect": {"match": [[0, 3]]}},
    {"id": "alternation-008", "cmd": "match", "pattern": "a|", "subject": "b", "expect": {"match": [[0, 0]]}},
    {"id": "alternation-009", "cmd": "match", "pattern": "|a", "subject": "a", "expect": {"match": [[0, 0]]}},
    {"id": "alternation-010", "cmd": "match", "pattern": "a||b", "subject": "b", "expect": {"match": [[0, 0]]}},
    {"id": "alternation-011", "cmd": "match", "pattern": "(?:a|)b", "subject": "b", "expect": {"match": [[0, 1]]}},
    {"id": "alternation-012", "cmd": "match", "pattern": "x(?:a|ab)y", "subject": "xaby", "expect": {"match": [[0, 4]]}},
    {"id": "alternation-013", "cmd": "match", "pattern": "(?:a|ab)(?:c|bcd)", "subject": "abcd", "expect": {"match": [[0, 4]]}},
    {"id": "alternation-014", "cmd": "match", "pattern": "(?:a|ab)(?:c|bcd)(?:d|)", "subject": "abcd", "expect": {"match": [[0, 4]]}},
    {"id": "alternation-015", "cmd": "match", "pattern": "cat|dog|bird", "subject": "a\\x20dog\\x20here", "expect": {"match": [[2, 5]]}},
    {"id": "alternation-016", "cmd": "match", "pattern": "cat|dog|bird", "subject": "a\\x20bird\\x20here", "expect": {"match": [[2, 6]]}},
    {"id": "alternation-017", "cmd": "match", "pattern": "cat|category", "subject": "category", "expect": {"match": [[0, 3]]}},
    {"id": "alternation-018", "cmd": "match", "pattern": "category|cat", "subject": "category", "expect": {"match": [[0, 8]]}},
    {"id": "alternation-019", "cmd": "match", "pattern": "^(?:a|b)c", "subject": "bc", "expect": {"match": [[0, 2]]}},
    {"id": "alternation-020", "cmd": "match", "pattern": "(?:a|b)*c", "subject": "ababc", "expect": {"match": [[0, 5]]}},
    {"id": "alternation-021", "cmd": "match", "pattern": "a|b|c|d|e", "subject": "zzedzz", "expect": {"match": [[2, 3]]}},
    {"id": "alternation-022", "cmd": "match", "pattern": "(?:foo|bar)baz", "subject": "barbaz", "expect": {"match": [[0, 6]]}},
    {"id": "alternation-023", "cmd": "match", "pattern": "\\\\d|\\\\w", "subject": "a1", "expect": {"match": [[0, 1]]}},
    {"id": "alternation-024", "cmd": "match", "pattern": "[abc]|z", "subject": "zc", "expect": {"match": [[0, 1]]}},
    {"id": "alternation-025", "cmd": "match", "pattern": "a.|.b", "subject": "ab", "expect": {"match": [[0, 2]]}},
    {"id": "alternation-026", "cmd": "match", "pattern": "(?:ab|a)(?:b|)", "subject": "ab", "expect": {"match": [[0, 2]]}},
    {"id": "alternation-027", "cmd": "match", "pattern": "x|xx|xxx", "subject": "xxx", "expect": {"match": [[0, 1]]}},
    {"id": "alternation-028", "cmd": "match", "pattern": "(?:x|xx|xxx)$", "subject": "xxx", "expect": {"match": [[0, 3]]}},
    {"id": "alternation-029", "cmd": "match", "pattern": "(?:ab|cd)+", "subject": "abcdab", "expect": {"match": [[0, 6]]}},
    {"id": "alternation-030", "cmd": "match", "pattern": "(?:ab|cd)+", "subject": "abzcd", "expect": {"match": [[0, 2]]}},
    {"id": "alternation-031", "cmd": "match", "pattern": "a(?:b|c)d", "subject": "acd", "expect": {"match": [[0, 3]]}},
    {"id": "alternation-032", "cmd": "match", "pattern": "a(?:b|c)d", "subject": "aed", "expect": {"match": null}},
    {"id": "alternation-033", "cmd": "match", "pattern": "^$|^a$", "subject": "a", "expect": {"match": [[0, 1]]}},
    {"id": "alternation-034", "cmd": "match", "pattern": "^$|^a$", "subject": "-", "expect": {"match": [[0, 0]]}},
    {"id": "alternation-035", "cmd": "match", "pattern": "one|two|three|four|five", "subject": "four", "expect": {"match": [[0, 4]]}}
  ]
