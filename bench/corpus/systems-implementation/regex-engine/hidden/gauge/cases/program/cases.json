    {"id": "program-017", "cmd": "program", "pattern": "[a\\x2dcb\\x2dd]", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["p 61-64"]}}},
    {"id": "program-018", "cmd": "program", "pattern": "[ac\\x2dde]", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["p 61-61 63-65"]}}},
    {"id": "program-019", "cmd": "program", "pattern": "[b\\x2dca\\x2da]", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["p 61-63"]}}},
    {"id": "program-020", "cmd": "program", "pattern": "[\\\\d\\\\s]", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["p 09-0d 20-20 30-39"]}}},
    {"id": "program-021", "cmd": "program", "pattern": "[\\xc3\\xa9\\x2d\\xc3\\xbf]", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["p e9-ff"]}}},
    {"id": "program-022", "cmd": "program", "pattern": "[\\xe6\\x97\\xa5\\x2d\\xe6\\x9c\\xac]", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["p 65e5-672c"]}}},
    {"id": "program-023", "cmd": "program", "pattern": "a|b", "expect": {"program": {"groups": 0, "min_instr": 6, "max_instr": 14, "count_ops": {"char": 2}, "require_ops": ["split"]}}},
    {"id": "program-024", "cmd": "program", "pattern": "a|b|c", "expect": {"program": {"groups": 0, "min_instr": 8, "max_instr": 20, "count_ops": {"char": 3}, "require_ops": ["split"]}}},
    {"id": "program-025", "cmd": "program", "pattern": "a*", "expect": {"program": {"groups": 0, "min_instr": 5, "max_instr": 12, "count_ops": {"char": 1}, "require_ops": ["split"]}}},
    {"id": "program-026", "cmd": "program", "pattern": "a+", "expect": {"program": {"groups": 0, "min_instr": 5, "max_instr": 12, "count_ops": {"char": 1}, "require_ops": ["split"]}}},
    {"id": "program-027", "cmd": "program", "pattern": "a?", "expect": {"program": {"groups": 0, "min_instr": 5, "max_instr": 12, "count_ops": {"char": 1}, "require_ops": ["split"]}}},
    {"id": "program-028", "cmd": "program", "pattern": "a*?", "expect": {"program": {"groups": 0, "min_instr": 5, "max_instr": 12, "count_ops": {"char": 1}, "require_ops": ["split"]}}},
    {"id": "program-029", "cmd": "program", "pattern": "a{3}", "expect": {"program": {"groups": 0, "min_instr": 6, "max_instr": 12, "count_ops": {"char": 3}}}},
    {"id": "program-030", "cmd": "program", "pattern": "a{3,5}", "expect": {"program": {"groups": 0, "min_instr": 8, "max_instr": 24, "count_ops": {"char": 5}, "require_ops": ["split"]}}},
    {"id": "program-031", "cmd": "program", "pattern": "a{0,4}", "expect": {"program": {"groups": 0, "min_instr": 6, "max_instr": 22, "count_ops": {"char": 4}, "require_ops": ["split"]}}},
    {"id": "program-032", "cmd": "program", "pattern": "a{100}", "expect": {"program": {"groups": 0, "min_instr": 102, "max_instr": 210, "count_ops": {"char": 100}}}},
    {"id": "program-033", "cmd": "program", "pattern": "^a$", "expect": {"program": {"groups": 0, "min_instr": 6, "max_instr": 12, "count_ops": {"char": 1}, "require_assert": ["bol", "eol"]}}},
    {"id": "program-034", "cmd": "program", "pattern": "\\\\ba\\\\B", "expect": {"program": {"groups": 0, "min_instr": 6, "max_instr": 12, "require_assert": ["wordb", "nwordb"]}}},
    {"id": "program-035", "cmd": "program", "pattern": "(a)", "expect": {"program": {"groups": 1, "min_instr": 6, "max_instr": 12, "count_ops": {"char": 1, "save": 4}}}},
    {"id": "program-036", "cmd": "program", "pattern": "(a)(b)", "expect": {"program": {"groups": 2, "min_instr": 8, "max_instr": 16, "count_ops": {"char": 2, "save": 6}}}},
    {"id": "program-037", "cmd": "program", "pattern": "((a))", "expect": {"program": {"groups": 2, "min_instr": 8, "max_instr": 16, "count_ops": {"char": 1, "save": 6}}}},
    {"id": "program-038", "cmd": "program", "pattern": "(?:a)", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 10, "count_ops": {"char": 1, "save": 2}}}},
    {"id": "program-039", "cmd": "program", "pattern": "(?:a)(b)", "expect": {"program": {"groups": 1, "min_instr": 6, "max_instr": 14, "count_ops": {"save": 4}}}},
    {"id": "program-040", "cmd": "program", "pattern": "(a){2}", "expect": {"program": {"groups": 1, "min_instr": 8, "max_instr": 18, "count_ops": {"char": 2, "save": 6}}}},
    {"id": "program-041", "cmd": "program", "pattern": "(a|b){2,3}", "expect": {"program": {"groups": 1, "min_instr": 14, "max_instr": 48, "count_ops": {"char": 6, "save": 8}, "require_ops": ["split"]}}},
    {"id": "program-042", "cmd": "program", "pattern": "(?:a|b)*c", "expect": {"program": {"groups": 0, "min_instr": 8, "max_instr": 20, "count_ops": {"char": 3}, "require_ops": ["split"]}}},
    {"id": "program-043", "cmd": "program", "pattern": "(a{100}){100}", "expect": {"program": {"groups": 1, "min_instr": 10000, "max_instr": 60000, "count_ops": {"char": 10000}}}},
    {"id": "program-044", "cmd": "program", "pattern": "(?:[a\\x2dz]|\\\\d)+@[a\\x2dz]{2,4}", "expect": {"program": {"groups": 0, "min_instr": 12, "max_instr": 60, "require_ops": ["split", "class", "char"]}}}
  ]
}
