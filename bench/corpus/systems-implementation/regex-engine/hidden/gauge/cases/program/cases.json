{
  "group": "program",
  "description": "The compiled program dump. Every case checks well-formedness (SPEC 9.3) plus structural facts that any correct compilation of the pattern must satisfy.",
  "default_time_limit_ms": 2000,
  "cases": [
    {"id": "program-001", "cmd": "program", "pattern": "-", "expect": {"program": {"groups": 0, "min_instr": 3, "max_instr": 6, "count_ops": {"char": 0, "save": 2, "match": 1}, "require_ops": ["save", "match"]}}},
    {"id": "program-002", "cmd": "program", "pattern": "a", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "count_ops": {"char": 1, "save": 2}, "require_char": ["61"], "forbid_ops": ["class", "any", "assert"]}}},
    {"id": "program-003", "cmd": "program", "pattern": "abc", "expect": {"program": {"groups": 0, "min_instr": 6, "max_instr": 12, "count_ops": {"char": 3, "save": 2}, "require_char": ["61", "62", "63"], "forbid_ops": ["class", "any"]}}},
    {"id": "program-004", "cmd": "program", "pattern": "\\xc3\\xa9", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "count_ops": {"char": 1}, "require_char": ["e9"]}}},
    {"id": "program-005", "cmd": "program", "pattern": "\\xf0\\x9f\\x98\\x80", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "count_ops": {"char": 1}, "require_char": ["1f600"]}}},
    {"id": "program-006", "cmd": "program", "pattern": "\\\\x41", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_char": ["41"]}}},
    {"id": "program-007", "cmd": "program", "pattern": ".", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "count_ops": {"any": 1, "char": 0}, "require_ops": ["any"], "forbid_ops": ["class"]}}},
    {"id": "program-008", "cmd": "program", "pattern": "[a\\x2dz]", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "count_ops": {"class": 1, "char": 0}, "require_class": ["p 61-7a"], "forbid_ops": ["any"]}}},
    {"id": "program-009", "cmd": "program", "pattern": "[^a\\x2dz]", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["n 61-7a"]}}},
    {"id": "program-010", "cmd": "program", "pattern": "[^\\\\n]", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["n 0a-0a"], "forbid_ops": ["any"]}}},
    {"id": "program-011", "cmd": "program", "pattern": "\\\\d", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["p 30-39"]}}},
    {"id": "program-012", "cmd": "program", "pattern": "\\\\D", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["n 30-39"]}}},
    {"id": "program-013", "cmd": "program", "pattern": "\\\\w", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["p 30-39 41-5a 5f-5f 61-7a"]}}},
    {"id": "program-014", "cmd": "program", "pattern": "\\\\W", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["n 30-39 41-5a 5f-5f 61-7a"]}}},
    {"id": "program-015", "cmd": "program", "pattern": "\\\\s", "expect": {"program": {"groups": 0, "min_instr": 4, "max_instr": 8, "require_class": ["p 09-0d 20-20"]}}},
