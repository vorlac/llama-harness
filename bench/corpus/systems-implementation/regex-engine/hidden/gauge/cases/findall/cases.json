{
  "group": "findall",
  "description": "Successive non-overlapping matches (SPEC 5.7): scan from the left, and after an empty match advance one code point.",
  "default_time_limit_ms": 2000,
  "cases": [
    {"id": "findall-001", "cmd": "find", "pattern": "a", "subject": "banana", "expect": {"find": [[1, 2], [3, 4], [5, 6]]}},
    {"id": "findall-002", "cmd": "find", "pattern": "a", "subject": "-", "expect": {"find": []}},
    {"id": "findall-003", "cmd": "find", "pattern": "a", "subject": "bbb", "expect": {"find": []}},
    {"id": "findall-004", "cmd": "find", "pattern": "an", "subject": "banana", "expect": {"find": [[1, 3], [3, 5]]}},
    {"id": "findall-005", "cmd": "find", "pattern": "ana", "subject": "banana", "expect": {"find": [[1, 4]]}},
    {"id": "findall-006", "cmd": "find", "pattern": "a*", "subject": "aab", "expect": {"find": [[0, 2], [2, 2], [3, 3]]}},
    {"id": "findall-007", "cmd": "find", "pattern": "a*", "subject": "-", "expect": {"find": [[0, 0]]}},
    {"id": "findall-008", "cmd": "find", "pattern": "a*", "subject": "bbb", "expect": {"find": [[0, 0], [1, 1], [2, 2], [3, 3]]}},
    {"id": "findall-009", "cmd": "find", "pattern": "a*", "subject": "aabaa", "expect": {"find": [[0, 2], [2, 2], [3, 5], [5, 5]]}},
    {"id": "findall-010", "cmd": "find", "pattern": "a+", "subject": "aabaa", "expect": {"find": [[0, 2], [3, 5]]}},
    {"id": "findall-011", "cmd": "find", "pattern": "a?", "subject": "ab", "expect": {"find": [[0, 1], [1, 1], [2, 2]]}},
    {"id": "findall-012", "cmd": "find", "pattern": "-", "subject": "abc", "expect": {"find": [[0, 0], [1, 1], [2, 2], [3, 3]]}},
    {"id": "findall-013", "cmd": "find", "pattern": "-", "subject": "-", "expect": {"find": [[0, 0]]}},
    {"id": "findall-014", "cmd": "find", "pattern": "b*", "subject": "abc", "expect": {"find": [[0, 0], [1, 2], [2, 2], [3, 3]]}},
    {"id": "findall-015", "cmd": "find", "pattern": "\\\\d+", "subject": "a1b22c333", "expect": {"find": [[1, 2], [3, 5], [6, 9]]}},
