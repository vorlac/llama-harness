    {"id": "findall-019", "cmd": "find", "pattern": ".", "subject": "abc", "expect": {"find": [[0, 1], [1, 2], [2, 3]]}},
    {"id": "findall-020", "cmd": "find", "pattern": ".", "subject": "a\\x0ab", "expect": {"find": [[0, 1], [2, 3]]}},
    {"id": "findall-021", "cmd": "find", "pattern": ".*", "subject": "ab", "expect": {"find": [[0, 2], [2, 2]]}},
    {"id": "findall-022", "cmd": "find", "pattern": ".*", "subject": "a\\x0ab", "expect": {"find": [[0, 1], [1, 1], [2, 3], [3, 3]]}},
    {"id": "findall-023", "cmd": "find", "pattern": "(?:ab)+", "subject": "ababXab", "expect": {"find": [[0, 4], [5, 7]]}},
