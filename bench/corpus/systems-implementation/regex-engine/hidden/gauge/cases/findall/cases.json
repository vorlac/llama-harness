    {"id": "findall-026", "cmd": "find", "pattern": "x*y", "subject": "xxyxy", "expect": {"find": [[0, 3], [3, 5]]}},
    {"id": "findall-027", "cmd": "find", "pattern": "[^,]*", "subject": "a,b", "expect": {"find": [[0, 1], [1, 1], [2, 3], [3, 3]]}},
    {"id": "findall-028", "cmd": "find", "pattern": ",", "subject": "a,b,c", "expect": {"find": [[1, 2], [3, 4]]}},
    {"id": "findall-029", "cmd": "find", "pattern": "\\\\ba", "subject": "a\\x20ba\\x20ab", "expect": {"find": [[0, 1], [5, 6]]}},
    {"id": "findall-030", "cmd": "find", "pattern": "a\\\\b", "subject": "a\\x20ba\\x20ab", "expect": {"find": [[0, 1], [3, 4]]}},
