    {"id": "findall-033", "cmd": "find", "pattern": "^", "subject": "abc", "expect": {"find": [[0, 0]]}},
    {"id": "findall-034", "cmd": "find", "pattern": "$", "subject": "abc", "expect": {"find": [[3, 3]]}},
    {"id": "findall-035", "cmd": "find", "pattern": "^$", "subject": "-", "expect": {"find": [[0, 0]]}},
    {"id": "findall-036", "cmd": "find", "pattern": "\\\\b", "subject": "ab\\x20cd", "expect": {"find": [[0, 0], [2, 2], [3, 3], [5, 5]]}},
    {"id": "findall-037", "cmd": "find", "pattern": "aa", "subject": "aaaa", "expect": {"find": [[0, 2], [2, 4]]}},
    {"id": "findall-038", "cmd": "find", "pattern": "aa|a", "subject": "aaa", "expect": {"find": [[0, 2], [2, 3]]}},
    {"id": "findall-039", "cmd": "find", "pattern": "(?:a|b)*", "subject": "abcab", "expect": {"find": [[0, 2], [2, 2], [3, 5], [5, 5]]}},
    {"id": "findall-040", "cmd": "find", "pattern": "\\\\d{2}", "subject": "123456", "expect": {"find": [[0, 2], [2, 4], [4, 6]]}},
    {"id": "findall-041", "cmd": "find", "pattern": "\\\\d{2}", "subject": "12345", "expect": {"find": [[0, 2], [2, 4]]}},
    {"id": "findall-042", "cmd": "find", "pattern": ".\\xc3\\xa9", "subject": "a\\xc3\\xa9b\\xc3\\xa9", "expect": {"find": [[0, 2], [2, 4]]}},
    {"id": "findall-043", "cmd": "find", "pattern": ".", "subject": "a\\xe2\\x82\\xac\\xf0\\x9f\\x98\\x80", "expect": {"find": [[0, 1], [1, 2], [2, 3]]}},
    {"id": "findall-044", "cmd": "find", "pattern": "[^\\xc3\\xa9]+", "subject": "a\\xc3\\xa9b\\xc3\\xa9c", "expect": {"find": [[0, 1], [2, 3], [4, 5]]}}
  ]
}
