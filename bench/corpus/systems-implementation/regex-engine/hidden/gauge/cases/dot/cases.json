{
  "group": "dot",
  "description": "The `.` metacharacter: any single code point except LF, and its interaction with quantifiers.",
  "default_time_limit_ms": 2000,
  "cases": [
    {"id": "dot-001", "cmd": "match", "pattern": ".", "subject": "-", "expect": {"match": null}},
    {"id": "dot-002", "cmd": "match", "pattern": ".", "subject": "a", "expect": {"match": [[0, 1]]}},
    {"id": "dot-003", "cmd": "match", "pattern": ".", "subject": "\\x0a", "expect": {"match": null}},
    {"id": "dot-004", "cmd": "match", "pattern": ".", "subject": "\\x0aa", "expect": {"match": [[1, 2]]}},
    {"id": "dot-005", "cmd": "match", "pattern": ".", "subject": "\\x20", "expect": {"match": [[0, 1]]}},
    {"id": "dot-006", "cmd": "match", "pattern": ".", "subject": "\\x09", "expect": {"match": [[0, 1]]}},
    {"id": "dot-007", "cmd": "match", "pattern": ".", "subject": "\\x0d", "expect": {"match": [[0, 1]]}},
    {"id": "dot-008", "cmd": "match", "pattern": "..", "subject": "a", "expect": {"match": null}},
    {"id": "dot-009", "cmd": "match", "pattern": "..", "subject": "ab", "expect": {"match": [[0, 2]]}},
    {"id": "dot-010", "cmd": "match", "pattern": "..", "subject": "a\\x0ab", "expect": {"match": null}},
    {"id": "dot-011", "cmd": "match", "pattern": "a.c", "subject": "abc", "expect": {"match": [[0, 3]]}},
    {"id": "dot-012", "cmd": "match", "pattern": "a.c", "subject": "a\\x0ac", "expect": {"match": null}},
    {"id": "dot-013", "cmd": "match", "pattern": "a.c", "subject": "ac", "expect": {"match": null}},
    {"id": "dot-014", "cmd": "match", "pattern": "a.c", "subject": "xa.cx", "expect": {"match": [[1, 4]]}},
    {"id": "dot-015", "cmd": "match", "pattern": ".*", "subject": "-", "expect": {"match": [[0, 0]]}},
    {"id": "dot-016", "cmd": "match", "pattern": ".*", "subject": "abc", "expect": {"match": [[0, 3]]}},
    {"id": "dot-017", "cmd": "match", "pattern": ".*", "subject": "ab\\x0acd", "expect": {"match": [[0, 2]]}},
    {"id": "dot-018", "cmd": "match", "pattern": ".*", "subject": "\\x0aabc", "expect": {"match": [[0, 0]]}},
    {"id": "dot-019", "cmd": "match", "pattern": ".+", "subject": "-", "expect": {"match": null}},
    {"id": "dot-020", "cmd": "match", "pattern": ".+", "subject": "abc", "expect": {"match": [[0, 3]]}},
    {"id": "dot-021", "cmd": "match", "pattern": ".+", "subject": "\\x0aabc", "expect": {"match": [[1, 4]]}},
    {"id": "dot-022", "cmd": "match", "pattern": ".?", "subject": "-", "expect": {"match": [[0, 0]]}},
    {"id": "dot-023", "cmd": "match", "pattern": ".?", "subject": "ab", "expect": {"match": [[0, 1]]}},
    {"id": "dot-024", "cmd": "match", "pattern": "a.*b", "subject": "axxbxxb", "expect": {"match": [[0, 7]]}},
    {"id": "dot-025", "cmd": "match", "pattern": "a.*?b", "subject": "axxbxxb", "expect": {"match": [[0, 4]]}},
    {"id": "dot-026", "cmd": "match", "pattern": "a.+b", "subject": "ab", "expect": {"match": null}},
    {"id": "dot-027", "cmd": "match", "pattern": "a.+b", "subject": "axb", "expect": {"match": [[0, 3]]}},
    {"id": "dot-028", "cmd": "match", "pattern": ".*a.*b", "subject": "zzazzbzz", "expect": {"match": [[0, 6]]}},
    {"id": "dot-029", "cmd": "match", "pattern": "....", "subject": "abc", "expect": {"match": null}},
    {"id": "dot-030", "cmd": "match", "pattern": ".a", "subject": "ba", "expect": {"match": [[0, 2]]}},
    {"id": "dot-031", "cmd": "match", "pattern": ".a", "subject": "a", "expect": {"match": null}},
    {"id": "dot-032", "cmd": "match", "pattern": "a.", "subject": "a", "expect": {"match": null}},
    {"id": "dot-033", "cmd": "match", "pattern": "a.", "subject": "ab", "expect": {"match": [[0, 2]]}},
    {"id": "dot-034", "cmd": "match", "pattern": ".\\\\n.", "subject": "a\\x0ab", "expect": {"match": [[0, 3]]}},
    {"id": "dot-035", "cmd": "match", "pattern": ".*.", "subject": "ab", "expect": {"match": [[0, 2]]}}
  ]
}
