{
  "group": "protocol",
  "description": "The harness contract itself (SPEC 3): framing, escaping, error replies for malformed requests, and shutdown on EOF.",
  "default_time_limit_ms": 2000,
  "cases": [
    {"id": "protocol-001", "cmd": "ping", "expect": {"raw": ["PONG"]}},
    {"id": "protocol-002", "cmd": "raw", "send": "MATCH a a", "expect": {"raw": ["MATCH 1 0 1"]}},
    {"id": "protocol-003", "cmd": "raw", "send": "MATCH \\x61 \\x61\\x62", "expect": {"raw": ["MATCH 1 0 1"]}, "note": "hex escapes on the wire decode before the pattern is parsed"},
    {"id": "protocol-004", "cmd": "raw", "send": "MATCH \\x41 \\x41", "expect": {"raw": ["MATCH 1 0 1"]}, "note": "uppercase hex digits are accepted on input"},
    {"id": "protocol-005", "cmd": "raw", "send": "MATCH \\x20 a\\x20b", "expect": {"raw": ["MATCH 1 1 2"]}, "note": "a space inside a token is always escaped"},
    {"id": "protocol-006", "cmd": "raw", "send": "MATCH a\\x0ab a\\x0ab", "expect": {"raw": ["MATCH 1 0 3"]}, "note": "a newline inside a token is always escaped"},
    {"id": "protocol-007", "cmd": "raw", "send": "MATCH \\\\\\\\ a\\\\\\\\b", "expect": {"raw": ["MATCH 1 1 2"]}, "note": "wire \"\\\\\\\\\" decodes to the two-character pattern \\\\, which matches one literal backslash"},
    {"id": "protocol-008", "cmd": "raw", "send": "MATCH - abc", "expect": {"raw": ["MATCH 1 0 0"]}, "note": "a lone \"-\" is the empty string: the empty pattern matches at 0"},
    {"id": "protocol-009", "cmd": "raw", "send": "MATCH a -", "expect": {"raw": ["NOMATCH"]}, "note": "an empty subject"},
    {"id": "protocol-010", "cmd": "raw", "send": "MATCH - -", "expect": {"raw": ["MATCH 1 0 0"]}, "note": "both tokens empty"},
    {"id": "protocol-011", "cmd": "raw", "send": "MATCH \\x2d a\\x2db", "expect": {"raw": ["MATCH 1 1 2"]}, "note": "a literal \"-\" is always written \\x2d, so a lone \"-\" is never ambiguous"},
    {"id": "protocol-012", "cmd": "raw", "send": "MATCH (a)(b)? ab", "expect": {"raw": ["MATCH 3 0 2 0 1 1 2"]}},
    {"id": "protocol-013", "cmd": "raw", "send": "MATCH (a)(b)? a", "expect": {"raw": ["MATCH 3 0 1 0 1 -1 -1"]}, "note": "a group that did not participate reports -1 -1"},
    {"id": "protocol-014", "cmd": "raw", "send": "MATCH zzz abc", "expect": {"raw": ["NOMATCH"]}},
    {"id": "protocol-015", "cmd": "raw", "send": "FIND an banana", "expect": {"raw": ["FIND 2 1 3 3 5"]}},
    {"id": "protocol-016", "cmd": "raw", "send": "FIND a\\x2a banana", "expect": {"raw": ["FIND 7 0 0 1 2 2 2 3 4 4 4 5 6 6 6"]}, "note": "the hex escape decodes to the pattern a*, whose empty matches follow the SPEC 5.7 scan rule"},
    {"id": "protocol-017", "cmd": "compile", "pattern": "a*b", "expect": {"compile": "ok", "min_instr": 4, "max_instr": 16}, "note": "COMPILE reports an instruction count, so the reply line is not a fixed string"},
    {"id": "protocol-018", "cmd": "raw", "send": "FOO a b", "expect": {"raw": ["ERROR unknown-command -1"]}},
    {"id": "protocol-019", "cmd": "raw", "send": "match a a", "expect": {"raw": ["ERROR unknown-command -1"]}, "note": "command verbs are case sensitive"},
    {"id": "protocol-020", "cmd": "raw", "send": "MATCH", "expect": {"raw": ["ERROR bad-request -1"]}},
    {"id": "protocol-021", "cmd": "raw", "send": "MATCH a", "expect": {"raw": ["ERROR bad-request -1"]}},
    {"id": "protocol-022", "cmd": "raw", "send": "MATCH a b c", "expect": {"raw": ["ERROR bad-request -1"]}},
    {"id": "protocol-023", "cmd": "raw", "send": "COMPILE", "expect": {"raw": ["ERROR bad-request -1"]}},
    {"id": "protocol-024", "cmd": "raw", "send": "PING x", "expect": {"raw": ["ERROR bad-request -1"]}},
    {"id": "protocol-025", "cmd": "raw", "send": "", "expect": {"raw": ["ERROR bad-request -1"]}, "note": "an empty request line"},
    {"id": "protocol-026", "cmd": "raw", "send": "MATCH \\q a", "expect": {"raw": ["ERROR bad-request -1"]}, "note": "an undefined wire escape is a malformed request, not a pattern error"},
    {"id": "protocol-027", "cmd": "raw", "send": "MATCH a\\ a", "expect": {"raw": ["ERROR bad-request -1"]}, "note": "a wire token may not end with a lone backslash"},
    {"id": "protocol-028", "cmd": "match", "pattern": "a$", "subject_build": [["a", 40000]], "expect": {"match": [[39999, 40000]]}, "time_limit_ms": 8000, "note": "a single request line of about 40 kB; do not assume a small fixed line buffer"},
    {"id": "protocol-029", "cmd": "eof-exit", "expect": {"exit_code": 0}, "time_limit_ms": 5000, "note": "closing stdin must make the harness exit 0 within five seconds; the runner restarts it afterwards"}
  ]
}
