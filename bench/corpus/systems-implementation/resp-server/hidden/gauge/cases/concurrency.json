  {
   "name": "interleaved-increments-from-two-clients",
   "steps": [
    {
     "cmd": [
      "SET",
      "n",
      "0"
     ],
     "expect": [
      "+",
      "OK"
     ],
     "client": "a"
    },
    {
     "cmd": [
      "INCR",
      "n"
     ],
     "expect": [
      ":",
      1
     ],
     "client": "a"
    },
    {
     "cmd": [
      "INCR",
      "n"
     ],
     "expect": [
      ":",
      2
     ],
     "client": "b"
    },
    {
     "cmd": [
      "INCR",
      "n"
     ],
     "expect": [
      ":",
      3
     ],
     "client": "a"
    },
    {
     "cmd": [
      "INCR",
      "n"
     ],
     "expect": [
      ":",
      4
     ],
     "client": "b"
    },
    {
     "cmd": [
      "GET",
      "n"
     ],
     "expect": [
      "$",
      "4"
     ],
