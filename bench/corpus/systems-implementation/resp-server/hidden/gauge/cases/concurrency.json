{
 "group": "concurrency",
 "description": "Multiple simultaneous connections, partial commands, and per-connection state isolation",
 "cases": [
  {
   "name": "partial-multibulk-does-not-block-another-client",
   "steps": [
    {
     "send": "*3\r\n$3\r\nSET\r\n$1\r\nk\r\n",
     "client": "slow"
    },
    {
     "cmd": [
      "PING"
     ],
     "expect": [
      "+",
      "PONG"
     ],
     "client": "fast"
    },
    {
     "cmd": [
      "SET",
      "other",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ],
     "client": "fast"
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      null
     ],
     "client": "fast"
    },
    {
     "send": "$5\r\nvalue\r\n",
     "expect": [
      "+",
      "OK"
     ],
     "client": "slow"
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      "value"
     ],
     "client": "fast"
    }
   ]
  },
  {
   "name": "partial-inline-does-not-block-another-client",
   "steps": [
    {
     "send": "PI",
     "client": "slow"
    },
    {
     "cmd": [
      "PING"
     ],
     "expect": [
      "+",
      "PONG"
     ],
     "client": "fast"
    },
    {
     "cmd": [
      "ECHO",
      "still-alive"
     ],
     "expect": [
      "$",
      "still-alive"
     ],
     "client": "fast"
    },
    {
     "send": "NG\r\n",
     "expect": [
      "+",
      "PONG"
     ],
     "client": "slow"
    }
   ]
  },
  {
   "name": "partial-bulk-header-does-not-block",
   "steps": [
    {
     "send": "*2\r\n$4\r\nECHO\r\n$5",
     "client": "slow"
    },
    {
     "cmd": [
      "PING"
     ],
     "expect": [
      "+",
      "PONG"
     ],
     "client": "fast"
    },
    {
     "send": "\r\nhello\r\n",
     "expect": [
      "$",
      "hello"
     ],
     "client": "slow"
    }
   ]
  },
  {
   "name": "two-slow-clients-and-one-fast",
   "steps": [
    {
     "send": "*2\r\n$3\r\nGET\r\n",
     "client": "s1"
    },
    {
     "send": "*2\r\n$4\r\nECHO\r\n",
     "client": "s2"
    },
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ],
     "client": "fast"
    },
    {
     "send": "$1\r\nk\r\n",
     "expect": [
      "$",
      "v"
     ],
     "client": "s1"
    },
    {
     "send": "$2\r\nhi\r\n",
     "expect": [
      "$",
      "hi"
     ],
     "client": "s2"
    },
    {
     "cmd": [
      "PING"
     ],
     "expect": [
      "+",
      "PONG"
     ],
     "client": "fast"
    }
   ]
  },
  {
   "name": "client-that-disconnects-mid-command-does-not-break-the-server",
   "steps": [
    {
     "send": "*3\r\n$3\r\nSET\r\n$1\r\nk\r\n",
     "client": "dead"
    },
    {
     "close": true,
     "client": "dead"
    },
    {
     "sleep_ms": 100
    },
    {
     "cmd": [
      "PING"
     ],
     "expect": [
      "+",
      "PONG"
     ],
     "client": "fast"
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      null
     ],
     "client": "fast"
    }
   ]
  },
