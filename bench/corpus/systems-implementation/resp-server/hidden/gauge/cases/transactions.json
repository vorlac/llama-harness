    {
     "cmd": [
      "EXEC"
     ],
     "expect": [
      "*",
      [
       [
        "+",
        "PONG"
       ]
      ]
     ]
    },
    {
     "cmd": [
      "EXEC"
     ],
     "expect": [
      "-",
      "ERR EXEC without MULTI"
     ]
    }
   ]
  },
