{
 "group": "transactions",
 "description": "MULTI, EXEC, DISCARD, WATCH and UNWATCH, including optimistic locking and abort semantics",
 "cases": [
  {
   "name": "multi-returns-ok",
   "steps": [
    {
     "cmd": [
      "MULTI"
     ],
     "expect": [
      "+",
      "OK"
     ]
    }
   ]
  },
  {
   "name": "queued-commands-reply-queued",
   "steps": [
    {
     "cmd": [
      "MULTI"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "QUEUED"
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "+",
      "QUEUED"
     ]
    }
   ]
  },
  {
   "name": "exec-runs-queue-in-order",
   "steps": [
    {
     "cmd": [
      "MULTI"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SET",
      "k",
      "1"
     ],
     "expect": [
      "+",
      "QUEUED"
     ]
    },
    {
     "cmd": [
      "INCR",
      "k"
     ],
     "expect": [
      "+",
      "QUEUED"
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "+",
      "QUEUED"
     ]
    },
    {
     "cmd": [
      "EXEC"
     ],
     "expect": [
      "*",
      [
       [
        "+",
        "OK"
       ],
       [
        ":",
        2
       ],
       [
        "$",
        "2"
       ]
      ]
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      "2"
     ]
    }
   ]
  },
  {
   "name": "exec-empty-queue",
   "steps": [
    {
     "cmd": [
      "MULTI"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "EXEC"
     ],
     "expect": [
      "*",
      []
     ]
    }
   ]
  },
  {
   "name": "exec-without-multi",
   "steps": [
    {
     "cmd": [
      "EXEC"
     ],
     "expect": [
      "-",
      "ERR EXEC without MULTI"
     ]
    }
   ]
  },
  {
   "name": "exec-twice",
   "steps": [
    {
     "cmd": [
      "MULTI"
     ],
