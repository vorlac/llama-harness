{
 "group": "strings",
 "description": "GET, SET and its options, GETSET, APPEND, the INCR family, STRLEN, MGET and MSET",
 "cases": [
  {
   "name": "get-missing-key",
   "steps": [
    {
     "cmd": [
      "GET",
      "nope"
     ],
     "expect": [
      "$",
      null
     ]
    }
   ]
  },
  {
   "name": "set-then-get",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      "v"
     ]
    }
   ]
  },
  {
   "name": "set-overwrites",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "a"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SET",
      "k",
      "b"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      "b"
     ]
    }
   ]
  },
  {
   "name": "set-empty-value",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      ""
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      ""
     ]
    },
    {
     "cmd": [
      "STRLEN",
      "k"
     ],
     "expect": [
      ":",
      0
     ]
    },
    {
     "cmd": [
      "EXISTS",
      "k"
     ],
     "expect": [
      ":",
      1
     ]
    }
   ]
  },
  {
   "name": "set-empty-key",
   "steps": [
    {
     "cmd": [
      "SET",
      "",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "GET",
      ""
     ],
     "expect": [
      "$",
      "v"
     ]
    },
    {
     "cmd": [
      "EXISTS",
      ""
     ],
     "expect": [
      ":",
      1
     ]
    }
   ]
  },
  {
   "name": "set-lowercase-command",
   "steps": [
    {
     "cmd": [
      "set",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "get",
      "k"
     ],
     "expect": [
      "$",
      "v"
     ]
    }
   ]
  },
  {
   "name": "set-keys-are-case-sensitive",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "lower"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SET",
      "K",
      "upper"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      "lower"
     ]
    },
    {
     "cmd": [
      "GET",
      "K"
     ],
     "expect": [
      "$",
      "upper"
     ]
    }
   ]
  },
  {
   "name": "set-overwrites-a-list",
   "steps": [
    {
     "cmd": [
      "RPUSH",
      "k",
      "a"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "TYPE",
      "k"
     ],
     "expect": [
      "+",
      "string"
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      "v"
     ]
    }
   ]
  },
  {
   "name": "get-on-list-is-wrongtype",
   "steps": [
    {
     "cmd": [
      "RPUSH",
      "k",
      "a"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "-",
      "WRONGTYPE Operation against a key holding the wrong kind of value"
     ]
    }
   ]
  },
  {
   "name": "set-ex-sets-ttl",
