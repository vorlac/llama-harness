{
 "group": "hashes",
 "description": "HSET, HGET, HDEL, HGETALL, HEXISTS, HINCRBY, HKEYS, HVALS, HLEN",
 "cases": [
  {
   "name": "hset-single-field",
   "steps": [
    {
     "cmd": [
      "HSET",
      "H",
      "f",
      "v"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "HGET",
      "H",
      "f"
     ],
     "expect": [
      "$",
      "v"
     ]
    },
    {
     "cmd": [
      "TYPE",
      "H"
     ],
     "expect": [
      "+",
      "hash"
     ]
    }
   ]
  },
  {
