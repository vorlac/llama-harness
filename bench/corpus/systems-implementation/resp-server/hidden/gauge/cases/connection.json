     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  },
  {
   "name": "flushdb-bad-option",
   "steps": [
    {
     "cmd": [
