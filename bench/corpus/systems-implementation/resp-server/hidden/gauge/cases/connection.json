{
 "group": "connection",
 "description": "PING, ECHO, SELECT, QUIT and the harness admin commands",
 "cases": [
  {
   "name": "ping-bare",
   "steps": [
    {
     "cmd": [
      "PING"
     ],
     "expect": [
      "+",
      "PONG"
     ]
    }
   ]
  },
  {
   "name": "ping-lowercase",
   "steps": [
    {
     "cmd": [
      "ping"
     ],
     "expect": [
      "+",
      "PONG"
     ]
    }
   ]
  },
  {
   "name": "ping-with-message",
   "steps": [
    {
     "cmd": [
      "PING",
      "hello"
     ],
     "expect": [
      "$",
      "hello"
     ]
    }
   ]
  },
  {
   "name": "ping-with-empty-message",
   "steps": [
    {
     "cmd": [
      "PING",
      ""
     ],
     "expect": [
      "$",
      ""
     ]
    }
   ]
  },
  {
   "name": "ping-with-binary-message",
   "steps": [
    {
     "cmd": [
      "PING",
      "a\r\nb"
     ],
     "expect": [
      "$",
      "a\r\nb"
     ]
    }
   ]
  },
  {
   "name": "ping-twice",
   "steps": [
    {
     "cmd": [
      "PING"
     ],
     "expect": [
      "+",
      "PONG"
     ]
    },
    {
     "cmd": [
      "PING"
     ],
     "expect": [
      "+",
      "PONG"
     ]
    }
   ]
  },
