    }
   ]
  },
  {
   "name": "select-keyspaces-are-independent",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "zero"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SELECT",
      "1"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      null
     ]
    },
    {
     "cmd": [
      "SET",
      "k",
      "one"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      "one"
     ]
    },
    {
     "cmd": [
      "SELECT",
      "0"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      "zero"
     ]
    }
   ]
  },
  {
   "name": "select-is-per-connection",
   "steps": [
    {
     "cmd": [
      "SELECT",
      "5"
     ],
     "expect": [
      "+",
      "OK"
     ],
     "client": "c1"
    },
    {
     "cmd": [
      "SET",
      "k",
      "five"
     ],
     "expect": [
      "+",
      "OK"
     ],
     "client": "c1"
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      null
     ],
     "client": "c2"
    },
    {
     "cmd": [
      "SELECT",
      "5"
     ],
     "expect": [
      "+",
      "OK"
     ],
     "client": "c2"
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      "five"
     ],
     "client": "c2"
    }
   ]
  },
  {
   "name": "select-survives-across-commands",
   "steps": [
    {
     "cmd": [
      "SELECT",
      "9"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SET",
      "a",
      "1"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "PING"
     ],
     "expect": [
      "+",
      "PONG"
     ]
    },
    {
     "cmd": [
      "GET",
      "a"
     ],
     "expect": [
      "$",
      "1"
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      1
     ]
    }
   ]
  },
  {
   "name": "select-does-not-clear-keys",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SELECT",
      "3"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SELECT",
      "0"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      "v"
     ]
    }
   ]
  },
  {
   "name": "quit-returns-ok-then-closes",
   "steps": [
    {
     "cmd": [
      "QUIT"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "expect_closed": true
    }
   ]
  },
  {
   "name": "quit-on-one-connection-leaves-others",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ],
     "client": "c1"
    },
    {
     "cmd": [
      "QUIT"
     ],
     "expect": [
      "+",
      "OK"
     ],
     "client": "c1"
    },
    {
     "expect_closed": true,
     "client": "c1"
    },
    {
     "cmd": [
      "GET",
      "k"
     ],
     "expect": [
      "$",
      "v"
     ],
     "client": "c2"
    }
   ]
  },
  {
   "name": "dbsize-empty-database",
   "steps": [
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  },
  {
   "name": "dbsize-counts-keys",
   "steps": [
    {
     "cmd": [
      "SET",
      "a",
      "1"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SET",
      "b",
      "2"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "RPUSH",
      "l",
      "x"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "HSET",
      "h",
      "f",
      "v"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "SADD",
      "s",
      "m"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      5
     ]
    }
   ]
  },
  {
   "name": "dbsize-is-per-database",
   "steps": [
    {
     "cmd": [
      "SET",
      "a",
      "1"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SELECT",
      "2"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      0
     ]
    },
    {
     "cmd": [
      "SET",
      "b",
      "2"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SET",
      "c",
      "3"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      2
     ]
    },
    {
     "cmd": [
      "SELECT",
      "0"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      1
     ]
    }
   ]
  },
  {
   "name": "dbsize-after-del",
   "steps": [
    {
     "cmd": [
      "MSET",
      "a",
      "1",
      "b",
      "2",
      "c",
      "3"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      3
     ]
    },
    {
     "cmd": [
      "DEL",
      "a",
      "b"
     ],
     "expect": [
      ":",
      2
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      1
     ]
    }
   ]
  },
  {
   "name": "flushdb-clears-current-database",
   "steps": [
    {
     "cmd": [
      "MSET",
      "a",
      "1",
      "b",
      "2"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "FLUSHDB"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      0
     ]
    },
    {
     "cmd": [
      "GET",
      "a"
     ],
     "expect": [
      "$",
      null
     ]
    }
   ]
  },
  {
   "name": "flushdb-does-not-touch-other-databases",
   "steps": [
    {
     "cmd": [
      "SET",
      "a",
      "0"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SELECT",
      "1"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SET",
      "a",
      "1"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "FLUSHDB"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      0
     ]
    },
    {
     "cmd": [
      "SELECT",
      "0"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "GET",
      "a"
     ],
     "expect": [
      "$",
      "0"
     ]
    }
   ]
  },
  {
   "name": "flushdb-async-accepted",
   "steps": [
    {
     "cmd": [
      "SET",
      "a",
      "1"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "FLUSHDB",
      "ASYNC"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  },
  {
   "name": "flushdb-sync-accepted",
   "steps": [
    {
     "cmd": [
      "SET",
      "a",
      "1"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
