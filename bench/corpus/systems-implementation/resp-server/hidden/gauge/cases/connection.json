  },
  {
   "name": "flushdb-on-empty-database",
   "steps": [
    {
     "cmd": [
      "FLUSHDB"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  }
 ]
