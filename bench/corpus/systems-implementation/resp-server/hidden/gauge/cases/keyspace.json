  },
  {
   "name": "rename-carries-ttl",
   "steps": [
    {
     "cmd": [
      "SET",
      "a",
      "v",
      "EX",
      "100"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "RENAME",
      "a",
      "b"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "TTL",
      "b"
     ],
     "expect": [
