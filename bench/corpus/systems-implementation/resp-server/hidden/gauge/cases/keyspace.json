  },
  {
   "name": "rename-basic",
   "steps": [
    {
     "cmd": [
      "SET",
      "a",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "RENAME",
      "a",
      "b"
     ],
     "expect": [
      "+",
      "OK"
