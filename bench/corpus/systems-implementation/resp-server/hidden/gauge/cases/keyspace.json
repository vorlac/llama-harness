      ":",
      1
     ]
    },
    {
     "cmd": [
      "SREM",
      "k",
      "m"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "TYPE",
      "k"
     ],
     "expect": [
      "+",
      "none"
     ]
    }
   ]
  },
  {
   "name": "type-changes-with-overwrite",
   "steps": [
    {
     "cmd": [
      "RPUSH",
      "k",
      "a"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "TYPE",
      "k"
     ],
     "expect": [
      "+",
      "string"
     ]
    }
