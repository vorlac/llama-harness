      "OK"
     ]
    },
    {
     "cmd": [
      "SET",
      "b",
      "2",
      "EX",
      "100"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "RENAME",
      "a",
      "b"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "TTL",
      "b"
     ],
     "expect": [
