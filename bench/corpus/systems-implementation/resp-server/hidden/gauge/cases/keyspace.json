      "a"
     ],
     "expect": [
      ":",
      0
     ]
    },
    {
     "cmd": [
      "GET",
      "b"
     ],
     "expect": [
      "$",
      "v"
     ]
    }
   ]
  },
  {
   "name": "rename-missing-source",
   "steps": [
    {
     "cmd": [
