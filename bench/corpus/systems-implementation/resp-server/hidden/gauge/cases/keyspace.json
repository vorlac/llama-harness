{
 "group": "keyspace",
 "description": "DEL, EXISTS, TYPE, RENAME and KEYS including glob matching",
 "cases": [
  {
   "name": "del-single-key",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DEL",
      "k"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "EXISTS",
      "k"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  },
  {
   "name": "del-missing-key",
   "steps": [
    {
     "cmd": [
      "DEL",
      "nope"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  },
  {
   "name": "del-multiple-keys",
   "steps": [
    {
     "cmd": [
      "MSET",
      "a",
      "1",
      "b",
      "2",
      "c",
      "3"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DEL",
      "a",
      "b",
      "c"
     ],
     "expect": [
      ":",
      3
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  },
  {
   "name": "del-partial-match",
   "steps": [
    {
     "cmd": [
      "MSET",
      "a",
      "1",
      "b",
      "2"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DEL",
      "a",
      "zzz",
      "b"
     ],
     "expect": [
      ":",
      2
     ]
    }
   ]
  },
  {
   "name": "del-duplicate-arguments-counted-once",
   "steps": [
    {
     "cmd": [
      "SET",
      "a",
      "1"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DEL",
      "a",
      "a"
     ],
     "expect": [
      ":",
      1
     ]
    }
   ]
  },
  {
   "name": "del-mixed-types",
   "steps": [
    {
     "cmd": [
      "SET",
      "s",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "RPUSH",
      "l",
      "x"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "HSET",
      "h",
      "f",
      "v"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "SADD",
      "t",
      "m"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "DEL",
      "s",
      "l",
      "h",
      "t"
     ],
     "expect": [
      ":",
      4
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  },
  {
   "name": "del-clears-ttl",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "v",
      "EX",
      "100"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "DEL",
      "k"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "SET",
      "k",
      "w"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "TTL",
      "k"
     ],
     "expect": [
      ":",
      -1
     ]
    }
   ]
  },
  {
   "name": "del-expired-key-returns-zero",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "v",
      "PX",
      "60"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "sleep_ms": 200
    },
    {
     "cmd": [
      "DEL",
      "k"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  },
  {
   "name": "exists-missing-key",
   "steps": [
    {
     "cmd": [
      "EXISTS",
      "nope"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  },
  {
   "name": "exists-single-key",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "EXISTS",
      "k"
     ],
     "expect": [
      ":",
      1
     ]
    }
   ]
  },
  {
   "name": "exists-counts-duplicates",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "EXISTS",
      "k",
      "k"
     ],
     "expect": [
      ":",
      2
     ]
    },
    {
     "cmd": [
      "EXISTS",
      "k",
      "k",
      "k"
     ],
     "expect": [
      ":",
      3
     ]
    }
   ]
  },
  {
   "name": "exists-mixed",
   "steps": [
    {
     "cmd": [
      "MSET",
      "a",
      "1",
      "b",
      "2"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "EXISTS",
      "a",
      "zz",
      "b",
      "yy"
     ],
     "expect": [
      ":",
      2
     ]
    }
   ]
  },
  {
   "name": "exists-duplicates-of-missing-key",
   "steps": [
    {
     "cmd": [
      "EXISTS",
      "nope",
      "nope"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  },
  {
   "name": "exists-on-every-type",
   "steps": [
    {
     "cmd": [
      "SET",
      "s",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "RPUSH",
      "l",
      "x"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "HSET",
      "h",
      "f",
      "v"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "SADD",
      "t",
      "m"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "EXISTS",
      "s",
      "l",
      "h",
      "t"
     ],
     "expect": [
      ":",
      4
     ]
    }
   ]
  },
  {
   "name": "exists-empty-key-name",
   "steps": [
    {
     "cmd": [
      "SET",
      "",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "EXISTS",
      ""
     ],
     "expect": [
      ":",
      1
     ]
    }
   ]
  },
  {
   "name": "type-missing-key",
   "steps": [
    {
     "cmd": [
      "TYPE",
