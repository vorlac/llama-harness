      "a",
      "1"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "SET",
      "b",
      "2"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "RENAME",
      "a",
      "b"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "GET",
      "b"
     ],
     "expect": [
      "$",
      "1"
     ]
    },
    {
     "cmd": [
      "DBSIZE"
     ],
     "expect": [
      ":",
      1
     ]
    }
   ]
  },
  {
   "name": "rename-overwrites-different-type",
   "steps": [
    {
     "cmd": [
      "SET",
      "a",
      "1"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "RPUSH",
      "b",
      "x"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "RENAME",
      "a",
      "b"
     ],
     "expect": [
      "+",
      "OK"
     ]
