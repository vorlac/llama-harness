{
 "group": "lists",
 "description": "LPUSH, RPUSH, LPOP, RPOP, LRANGE, LLEN, LREM, LINDEX and the empty-list deletion rule",
 "cases": [
  {
   "name": "rpush-single",
   "steps": [
    {
     "cmd": [
      "RPUSH",
      "L",
      "a"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "LRANGE",
      "L",
      "0",
      "-1"
     ],
     "expect": [
      "*",
      [
       "a"
      ]
     ]
    }
   ]
  },
  {
   "name": "rpush-multiple-appends-in-order",
   "steps": [
    {
     "cmd": [
      "RPUSH",
      "L",
      "a",
      "b",
      "c"
     ],
     "expect": [
      ":",
      3
     ]
    },
    {
     "cmd": [
      "LRANGE",
      "L",
      "0",
      "-1"
     ],
     "expect": [
      "*",
      [
       "a",
       "b",
       "c"
      ]
     ]
    }
   ]
  },
  {
   "name": "lpush-multiple-prepends-in-order",
   "steps": [
    {
     "cmd": [
      "LPUSH",
      "L",
      "a",
      "b",
      "c"
     ],
     "expect": [
      ":",
      3
     ]
    },
    {
     "cmd": [
      "LRANGE",
      "L",
      "0",
      "-1"
     ],
     "expect": [
      "*",
      [
       "c",
       "b",
       "a"
      ]
     ]
    }
   ]
  },
  {
   "name": "lpush-then-rpush",
   "steps": [
    {
     "cmd": [
      "LPUSH",
      "L",
      "b"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "LPUSH",
      "L",
      "a"
     ],
     "expect": [
      ":",
      2
     ]
    },
    {
     "cmd": [
      "RPUSH",
      "L",
      "c"
     ],
     "expect": [
      ":",
      3
     ]
    },
    {
     "cmd": [
      "LRANGE",
      "L",
      "0",
      "-1"
     ],
     "expect": [
      "*",
      [
       "a",
       "b",
       "c"
      ]
     ]
    }
   ]
  },
  {
   "name": "rpush-returns-growing-length",
   "steps": [
    {
     "cmd": [
      "RPUSH",
      "L",
      "a"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "RPUSH",
      "L",
      "b",
      "c"
     ],
     "expect": [
      ":",
      3
     ]
    },
    {
     "cmd": [
      "RPUSH",
      "L",
      "d"
     ],
     "expect": [
      ":",
      4
     ]
    }
   ]
  },
  {
   "name": "push-allows-duplicates",
   "steps": [
    {
     "cmd": [
      "RPUSH",
      "L",
      "a",
      "a",
      "a"
     ],
     "expect": [
      ":",
      3
     ]
    },
    {
     "cmd": [
      "LRANGE",
      "L",
      "0",
      "-1"
     ],
     "expect": [
      "*",
      [
       "a",
       "a",
       "a"
      ]
     ]
    },
    {
     "cmd": [
      "LLEN",
      "L"
     ],
     "expect": [
      ":",
      3
     ]
    }
   ]
  },
  {
   "name": "push-empty-string-value",
   "steps": [
    {
     "cmd": [
      "RPUSH",
      "L",
      ""
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "LINDEX",
      "L",
      "0"
     ],
     "expect": [
      "$",
      ""
     ]
    },
    {
     "cmd": [
      "LLEN",
      "L"
     ],
     "expect": [
      ":",
      1
     ]
    }
   ]
  },
