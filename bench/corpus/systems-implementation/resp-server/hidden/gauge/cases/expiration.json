{
 "group": "expiration",
 "description": "EXPIRE, PEXPIRE, TTL, PTTL, PERSIST, lazy expiration and the active expire cycle",
 "cases": [
  {
   "name": "expire-sets-ttl",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
     "expect": [
      "+",
      "OK"
     ]
    },
    {
     "cmd": [
      "EXPIRE",
      "k",
      "100"
     ],
     "expect": [
      ":",
      1
     ]
    },
    {
     "cmd": [
      "TTL",
      "k"
     ],
     "expect": [
      ":~",
      [
       99,
       100
      ]
     ]
    }
   ]
  },
  {
   "name": "expire-on-missing-key",
   "steps": [
    {
     "cmd": [
      "EXPIRE",
      "nope",
      "100"
     ],
     "expect": [
      ":",
      0
     ]
    }
   ]
  },
  {
   "name": "expire-zero-deletes-key",
   "steps": [
    {
     "cmd": [
      "SET",
      "k",
      "v"
     ],
