{
  "group": "depth",
  "description": "The call-depth limit and the operand-stack limit: the boundary cases either side of each, and the errors they raise.",
  "case_count": 19,
  "cases": [
    {
      "id": "depth-001-limit",
      "mode": "exec",
      "args": [
        "--max-depth",
        "8"
      ],
      "source": "asm/depth-001-limit.asm",
      "expect_exit": 0,
      "expect_stdout": "6\n"
    },
    {
      "id": "depth-002-limit",
      "mode": "exec",
      "args": [
        "--max-depth",
        "8"
      ],
      "source": "asm/depth-002-limit.asm",
      "expect_exit": 5,
      "expect_stdout": "",
      "expect_error": "E_STACK_OVERFLOW"
    },
    {
