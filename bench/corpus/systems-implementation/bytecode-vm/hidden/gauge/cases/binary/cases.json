      "note": "comments, blank lines and indentation carry no bytes"
    },
    {
      "id": "binary-005-intern",
      "mode": "asm",
      "source": "asm/binary-005-intern.asm",
      "expect_exit": 0,
      "expect_bytes_hex": "53564d3101000000030000000100000002040000006d61696e0105000000000000000201000000610000000000000000110000000401000401002005020005020070808051",
      "note": "equal constants are interned to a single pool entry"
    },
    {
      "id": "binary-006-intern",
      "mode": "asm",
      "source": "asm/binary-006-intern.asm",
      "expect_exit": 0,
      "expect_bytes_hex": "53564d3101000000030000000100000002040000006d61696e010100000000000000020100000031000000000000000009000000040100050200808051",
      "note": "the integer 1 and the string \"1\" are different constants"
    },
    {
      "id": "binary-007-poolorder",
      "mode": "asm",
      "source": "asm/binary-007-poolorder.asm",
      "expect_exit": 0,
      "expect_bytes_hex": "53564d3101000000040000000200000002040000006d61696e01070000000000000002060000007365636f6e6401080000000000000000000000000000000900000004010006520100065102000000000000000400000004030051",
      "note": "each function's name is interned before the constants in its body"
    },
    {
      "id": "binary-008-globalname",
      "mode": "asm",
      "source": "asm/binary-008-globalname.asm",
      "expect_exit": 0,
      "expect_bytes_hex": "53564d3101000000030000000100000002040000006d61696e01010000000000000002010000006700000000000000000b0000000401001302001202008051",
      "note": "a global name is a string constant like any other"
    },
    {
      "id": "binary-009-upvaldesc",
      "mode": "asm",
      "source": "asm/binary-009-upvaldesc.asm",
      "expect_exit": 0,
      "expect_bytes_hex": "53564d3101000000030000000200000002040000006d61696e010300000000000000020300000067657400000000000100000c0000000401001100520100500080510200000000000100000003000000140051",
      "note": "upvalue descriptors sit between the function header and the code"
    },
    {
      "id": "binary-010-dis",
      "mode": "dis",
      "source": "asm/binary-010-dis.asm",
      "expect_exit": 0,
      "expect_stdout": "; svm disassembly\n.func main arity=0 locals=0 upvals=0\n  RET\n.end\n"
    },
    {
      "id": "binary-011-dis",
      "mode": "dis",
      "source": "asm/binary-011-dis.asm",
      "expect_exit": 0,
      "expect_stdout": "; svm disassembly\n.func main arity=0 locals=0 upvals=0\n  PUSH_STR \"hello, svm\"\n  PRINT\n  PUSH_INT 6\n  PUSH_INT 7\n  MUL\n  PRINT\n  RET\n.end\n"
    },
    {
      "id": "binary-012-dis",
      "mode": "dis",
      "source": "asm/binary-012-dis.asm",
      "expect_exit": 0,
      "expect_stdout": "; svm disassembly\n.func main arity=0 locals=1 upvals=0\n  PUSH_INT 3\n  STORE_LOCAL 0\nL0005:\n  LOAD_LOCAL 0\n  JMP_IF_FALSE L0018\n  LOAD_LOCAL 0\n  PRINT\n  LOAD_LOCAL 0\n  PUSH_INT 1\n  SUB\n  STORE_LOCAL 0\n  JMP L0005\nL0018:\n  RET\n.end\n",
      "note": "labels are named after the byte offset they mark"
    },
    {
      "id": "binary-013-dis",
      "mode": "dis",
      "source": "asm/binary-013-dis.asm",
      "expect_exit": 0,
      "expect_stdout": "; svm disassembly\n.func main arity=0 locals=0 upvals=0\n  CLOSURE outer\n  PUSH_INT 7\n  CALL 1\n  CALL 0\n  PRINT\n  RET\n.end\n.func outer arity=1 locals=1 upvals=0\n  CLOSURE inner\n  RET\n.end\n.func inner arity=0 locals=0 upvals=1\n  .upval local 0\n  LOAD_UPVAL 0\n  RET\n.end\n"
    },
    {
      "id": "binary-014-dis",
      "mode": "dis",
      "source": "asm/binary-014-dis.asm",
      "expect_exit": 0,
      "expect_stdout": "; svm disassembly\n.func main arity=0 locals=0 upvals=0\n  PUSH_INT 1\n  STORE_GLOBAL \"odd name\"\n  LOAD_GLOBAL \"odd name\"\n  PRINT\n  RET\n.end\n",
      "note": "a global name that is not an identifier is quoted"
    },
    {
      "id": "binary-015-dis",
      "mode": "dis",
      "source": "asm/binary-015-dis.asm",
      "expect_exit": 0,
      "expect_stdout": "; svm disassembly\n.func main arity=0 locals=0 upvals=0\n  PUSH_STR \"a\\nb\\t\\\"c\\\"\\\\d\"\n  PRINT\n  PUSH_INT 0\n  CHR\n  PRINT\n  RET\n.end\n",
      "note": "string constants are re-emitted with the canonical escapes"
    },
    {
      "id": "binary-016-dis",
      "mode": "dis",
      "source": "asm/binary-016-dis.asm",
