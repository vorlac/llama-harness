{
  "group": "binary",
  "description": "The on-disk module format: byte-exact assembler output, constant-pool interning order, the canonical disassembly, and assemble/disassemble round-tripping.",
  "case_count": 33,
  "cases": [
    {
      "id": "binary-001-golden",
      "mode": "asm",
      "source": "asm/binary-001-golden.asm",
      "expect_exit": 0,
      "expect_bytes_hex": "53564d3101000000010000000100000002040000006d61696e00000000000000000100000051",
      "note": "the smallest legal module, 38 bytes"
    },
    {
