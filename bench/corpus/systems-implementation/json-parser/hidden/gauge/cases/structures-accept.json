    {"id": "structures-accept-029", "note": "b'{\"x\":{\"y\":{\"z\":{}}}}'", "input": "{\"x\":{\"y\":{\"z\":{}}}}", "expect": "accept", "canonical": "{\"x\":{\"y\":{\"z\":{}}}}"},
