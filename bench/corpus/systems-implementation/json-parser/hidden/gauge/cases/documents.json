{
  "group": "documents",
  "description": "Whole documents, exercising round-trip canonicalisation.",
  "cases": [
    {"id": "documents-001", "note": "document round-trip", "input": "{\"name\":\"harness\",\"version\":\"1.4.0\",\"tags\":[\"json\",\"parser\"],\"enabled\":true,\"threads\":8,\"timeout\":2.5,\"notes\":null}", "expect": "accept", "canonical": "{\"enabled\":true,\"name\":\"harness\",\"notes\":null,\"tags\":[\"json\",\"parser\"],\"threads\":8,\"timeout\":2.5,\"version\":\"1.4.0\"}"},
    {"id": "documents-002", "note": "document round-trip", "input": "{\"z\":26,\"m\":13,\"a\":1,\"nested\":{\"z\":1,\"a\":{\"b\":[1,2,3],\"a\":{}}}}", "expect": "accept", "canonical": "{\"a\":1,\"m\":13,\"nested\":{\"a\":{\"a\":{},\"b\":[1,2,3]},\"z\":1},\"z\":26}"},
    {"id": "documents-003", "note": "document round-trip", "input": "[{\"id\":1,\"score\":-0.5},{\"id\":2,\"score\":1e3},{\"id\":3,\"score\":0}]", "expect": "accept", "canonical": "[{\"id\":1,\"score\":-0.5},{\"id\":2,\"score\":1000},{\"id\":3,\"score\":0}]"},
    {"id": "documents-004", "note": "document round-trip", "input": "{\"type\":\"FeatureCollection\",\"features\":[{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[-122.4194,37.7749]},\"properties\":{\"name\":\"San Francisco\",\"population\":873965}}]}", "expect": "accept", "canonical": "{\"features\":[{\"geometry\":{\"coordinates\":[-122.4194,37.7749],\"type\":\"Point\"},\"properties\":{\"name\":\"San Francisco\",\"population\":873965},\"type\":\"Feature\"}],\"type\":\"FeatureCollection\"}"},
    {"id": "documents-005", "note": "document round-trip", "input": "{\"unicode\":{\"greek\":\"\\u03b1\\u03b2\\u03b3\",\"emoji\":\"\\ud83d\\ude80\",\"cjk\":\"\\u4e2d\\u6587\",\"escaped\":\"tab\\there\\nnewline\"}}", "expect": "accept", "canonical": "{\"unicode\":{\"cjk\":\"\\u4e2d\\u6587\",\"emoji\":\"\\ud83d\\ude80\",\"escaped\":\"tab\\there\\nnewline\",\"greek\":\"\\u03b1\\u03b2\\u03b3\"}}"},
    {"id": "documents-006", "note": "document round-trip", "input": "{\"matrix\":[[1,0,0],[0,1,0],[0,0,1]],\"trace\":3,\"det\":1.0}", "expect": "accept", "canonical": "{\"det\":1,\"matrix\":[[1,0,0],[0,1,0],[0,0,1]],\"trace\":3}"},
    {"id": "documents-007", "note": "document round-trip", "input": "{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":[]}}}}}}}}", "expect": "accept", "canonical": "{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":[]}}}}}}}}"},
    {"id": "documents-008", "note": "document round-trip", "input": "{\"empty_string\":\"\",\"empty_array\":[],\"empty_object\":{},\"zero\":0,\"negative_zero\":-0,\"false\":false}", "expect": "accept", "canonical": "{\"empty_array\":[],\"empty_object\":{},\"empty_string\":\"\",\"false\":false,\"negative_zero\":-0,\"zero\":0}"},
    {"id": "documents-009", "note": "document round-trip", "input": "{\"big\":1e400,\"small\":1e-400,\"exact\":9007199254740993,\"long\":12345678901234567890123456789012345678901234567890}", "expect": "accept", "canonical": "{\"big\":1e400,\"exact\":9007199254740993,\"long\":1.234567890123456789012345678901234567890123456789e49,\"small\":1e-400}"},
    {"id": "documents-010", "note": "document round-trip", "input": "{\"duplicate\":1,\"other\":\"x\",\"duplicate\":{\"replaced\":true}}", "expect": "accept", "canonical": "{\"duplicate\":{\"replaced\":true},\"other\":\"x\"}"},
    {"id": "documents-011", "note": "document round-trip", "input": "[\" \",\"\\u0000\",\"\\u001f\",\"\\u007f\",\"\\u0080\",\"\\uffff\",\"\\ud83d\\udc4d\"]", "expect": "accept", "canonical": "[\" \",\"\\u0000\",\"\\u001f\",\"\\u007f\",\"\\u0080\",\"\\uffff\",\"\\ud83d\\udc4d\"]"},
    {"id": "documents-012", "note": "document round-trip", "input": "{\"config\":{\"retries\":3,\"backoff\":[0.1,0.2,0.4,0.8],\"endpoints\":{\"primary\":\"https:\\/\\/a.example\\/v1\",\"fallback\":null},\"flags\":{\"verbose\":false,\"dry_run\":true}}}", "expect": "accept", "canonical": "{\"config\":{\"backoff\":[0.1,0.2,0.4,0.8],\"endpoints\":{\"fallback\":null,\"primary\":\"https://a.example/v1\"},\"flags\":{\"dry_run\":true,\"verbose\":false},\"retries\":3}}"},
