.out/
.data/

# Stray CMake trees. Everything in this workspace configures through
# CMakePresets.json, whose binaryDir is .out/build/<presetName>, so these two
# should stay EMPTY — they are ignored to catch an ad-hoc `cmake -B build`
# rather than to sanction one.
build/
out/
# the conductor build-state directory is durable state, not a build tree
!docs/build/

# conductor dev tooling (G1: types/dev only, never runtime)
conductor/node_modules/

__pycache__/
*.pyc

.DS_Store

.vs/**
!.vs/launch.vs.json
!.vs/VSWorkspaceSettings.json
!.vs/CMakeWorkspaceSettings.json

.vscode/**
!.vscode/c_cpp_properties.json
!.vscode/launch.json

# Task 11.1: generated §2 JSON Schemas for the C++ router-tests (from core/types.ts SCHEMAS)
router/tests/schemas/

# The conductor build's scratch area: a red test file is authored here and parked
# until the task that owns it starts, at which point the authoritative copy lands
# in conductor/tests/ or router/tests/. Working files, never deliverables.
staging/
