{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["core/**/*.ts", "adapter/**/*.ts", "plugin/**/*.ts", "tools/**/*.ts", "tests/**/*.ts"]
}
